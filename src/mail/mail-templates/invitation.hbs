<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
</head>

<body style="margin:0;font-family:arial">
    <table style="border:0;width:100%">
        <tr style="background:#eeeeee">
            <td style="padding:20px;color:#808080;text-align:center;font-size:40px;font-weight:600">
                {{app_name}}
            </td>
        </tr>
        <tr>
            <td style="padding:20px;color:#808080;font-size:16px;font-weight:100">
                {{text1}}<br><br>
                {{text2}} <strong>{{tenantName}}</strong>{{#if branchName}} ({{branchName}}){{/if}}.<br><br>
                {{text3}} <strong>{{roleName}}</strong>.<br><br>
                {{text4}}
            </td>
        </tr>
        <tr>
            <td style="text-align:center;padding:20px">
                <a href="{{url}}"
                    style="display:inline-block;padding:20px 40px;background:#00838f;text-decoration:none;color:#ffffff;font-size:16px;border-radius:4px">{{actionTitle}}</a>
            </td>
        </tr>
        <tr>
            <td style="padding:20px;color:#aaaaaa;font-size:12px;text-align:center">
                {{text5}}
            </td>
        </tr>
    </table>
</body>

</html>
